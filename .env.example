# Salin ke .env lalu isi nilainya
PORT=3000
SESSION_SECRET=ganti-dengan-string-acak-panjang
HYDRALIVE_SECRET=ganti-dengan-string-acak-panjang-lain
DB_PATH=./data/hydra.db

# YouTube OAuth (Fase 3) — opsional, default pakai http://localhost:PORT/auth/youtube/callback
# YOUTUBE_REDIRECT_URI=https://domain-lu.com/auth/youtube/callback

# Telegram (Fase 3) — bisa juga diisi lewat halaman Settings
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
