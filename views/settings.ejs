<%- include('partials/header', { title: 'SETTINGS', active: 'settings' }) %>

<p class="hz-sec">ENCODER_DEFAULTS</p>
<div class="hz-card">
  <form method="POST" action="/settings" class="hz-form">
    <div class="hz-field">
      <label>VIDEO BITRATE</label>
      <select class="hz-select" name="video_bitrate">
        <% ['2500k','4500k','6000k','8000k'].forEach(function(b){ %>
          <option value="<%= b %>" <%= settings.video_bitrate===b?'selected':'' %>><%= b %></option>
        <% }) %>
      </select>
      <p class="hz-hint">▸ 4500k aman untuk 1080p YouTube. 6000k–8000k untuk kualitas maksimal.</p>
    </div>
    <div class="hz-field">
      <label>FFMPEG PRESET</label>
      <select class="hz-select" name="ffmpeg_preset">
        <% ['ultrafast','superfast','veryfast','faster','fast','medium'].forEach(function(p){ %>
          <option value="<%= p %>" <%= settings.ffmpeg_preset===p?'selected':'' %>><%= p %></option>
        <% }) %>
      </select>
      <p class="hz-hint">▸ veryfast = seimbang. ultrafast = ringan CPU, file lebih besar.</p>
    </div>
    <div class="hz-field">
      <button class="hz-btn go" type="submit">💾 SIMPAN</button>
    </div>
  </form>
</div>

<p class="hz-sec" style="margin-top:20px">NOTIFIKASI_TELEGRAM</p>
<div class="hz-card">
  <form method="POST" action="/settings" class="hz-form">
    <div class="hz-field">
      <label>AKTIFKAN</label>
      <select class="hz-select" name="telegram_enabled">
        <option value="1" <%= settings.telegram_enabled==='1'?'selected':'' %>>YA</option>
        <option value="0" <%= settings.telegram_enabled!=='1'?'selected':'' %>>TIDAK</option>
      </select>
    </div>
    <div class="hz-field">
      <label>BOT TOKEN <span class="hz-dim">(dari @BotFather)</span></label>
      <input class="hz-input" type="password" name="telegram_bot_token" value="<%= settings.telegram_bot_token || '' %>" autocomplete="off" placeholder="123456:ABC-DEF...">
    </div>
    <div class="hz-field">
      <label>CHAT ID <span class="hz-dim">(dari @userinfobot)</span></label>
      <input class="hz-input" name="telegram_chat_id" value="<%= settings.telegram_chat_id || '' %>" placeholder="123456789">
    </div>
    <div class="hz-field hz-field-btn">
      <button class="hz-btn go" type="submit">💾 SIMPAN</button>
    </div>
  </form>
  <div class="hz-btnrow">
    <button class="hz-btn" id="hzTgTest">✉ TEST NOTIFIKASI</button>
  </div>
  <p class="hz-hint">▸ Terkirim saat: rotasi error (throttle 15 mnt), stream health buruk, dan saat pulih kembali.</p>
</div>

<script>
  document.getElementById('hzTgTest').addEventListener('click', function(){
    fetch('/api/telegram/test', { method: 'POST' })
      .then(function(r){ return r.json(); })
      .then(function(d){ alert(d.ok ? 'Terkirim! Cek Telegram lu.' : 'Gagal — cek token & chat ID, lalu SIMPAN dulu.'); });
  });
</script>

<p class="hz-sec" style="margin-top:20px">SYSTEM</p>
<div class="hz-card">
  <div class="hz-stat"><span>database</span><b>data/hydra.db</b></div>
  <div class="hz-stat"><span>upload dir</span><b>uploads/</b></div>
  <div class="hz-stat"><span>version</span><b class="cy">V9 // NIGHTFALL</b></div>
</div>

<%- include('partials/footer') %>
