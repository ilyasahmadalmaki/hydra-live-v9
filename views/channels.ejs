<%- include('partials/header', { title: 'CHANNELS', active: 'channels' }) %>

<p class="hz-sec">DAFTAR_CHANNEL</p>
<div class="hz-card">
  <% if (!channels.length) { %>
    <div class="hz-empty">_belum ada channel. tambahkan di bawah_</div>
  <% } else { %>
    <table class="hz-table">
      <thead><tr><th>NAMA</th><th>MODE</th><th>RTMP URL</th><th>STREAM KEY</th><th>STATUS</th><th>AKSI</th></tr></thead>
      <tbody>
        <% channels.forEach(function(c){ %>
          <tr>
            <td><b><%= c.name %></b></td>
            <td><span class="hz-tag">STREAMKEY</span></td>
            <td class="hz-mono-sm"><%= c.rtmp_url || '—' %></td>
            <td class="hz-mono-sm"><%= c.stream_key ? c.stream_key.slice(0,4) + '••••••••' : '—' %></td>
            <td><%= c.is_active ? '<span class="hz-tag go">AKTIF</span>' : '<span class="hz-dim">—</span>' %></td>
            <td class="hz-acts">
              <% if (!c.is_active) { %>
                <form method="POST" action="/channels/<%= c.id %>/activate">
                  <button class="hz-btn go sm" type="submit">AKTIFKAN</button>
                </form>
              <% } %>
              <form method="POST" action="/channels/<%= c.id %>/delete" onsubmit="return confirm('Hapus channel <%= c.name %>? Broadcast miliknya ikut terhapus.')">
                <button class="hz-btn sm" type="submit">✕</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<p class="hz-sec" style="margin-top:20px">TAMBAH_CHANNEL</p>
<div class="hz-card">
  <form method="POST" action="/channels" class="hz-form">
    <div class="hz-field">
      <label>NAMA CHANNEL</label>
      <input class="hz-input" name="name" required placeholder="Rain Sounds ID">
    </div>
    <div class="hz-field">
      <label>RTMP URL <span class="hz-dim">(dari YouTube Studio → Stream settings)</span></label>
      <input class="hz-input" name="rtmp_url" required placeholder="rtmp://a.rtmp.youtube.com/live2">
    </div>
    <div class="hz-field">
      <label>STREAM KEY</label>
      <input class="hz-input" type="password" name="stream_key" required placeholder="xxxx-xxxx-xxxx-xxxx" autocomplete="off">
    </div>
    <div class="hz-field">
      <button class="hz-btn go" type="submit">+ TAMBAH</button>
    </div>
  </form>
  <p class="hz-hint">▸ Ambil dari YouTube Studio → <b>Go Live</b> → <b>Stream</b> → salin <i>Stream URL</i> &amp; <i>Stream key</i>.<br>
  ▸ Mode API (OAuth) hadir di Fase 3 — untuk sekarang semua channel pakai streamkey.</p>
</div>

<%- include('partials/footer') %>
