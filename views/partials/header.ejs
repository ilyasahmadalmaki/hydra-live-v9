<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= appName %> // <%= title %></title>
<link rel="stylesheet" href="/css/hydra.css">
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
</head>
<body>
<div class="hz-root">
  <div class="hz-grid-bg"></div>

  <header class="hz-topbar">
    <div class="hz-logo">HYDRA<span>LIVE</span></div>
    <div class="hz-badge">SYS.ONLINE</div>
    <div class="hz-badge warn">V9 // NIGHTFALL</div>

    <% if (channels && channels.length) { %>
      <form id="hzChForm" method="POST" action="" class="hz-chswitch">
        <span class="hz-chswitch-label">CHANNEL ▸</span>
        <select id="hzChSel" class="hz-select hz-select-sm">
          <% channels.forEach(function(c){ %>
            <option value="<%= c.id %>" <%= activeChannel && activeChannel.id === c.id ? 'selected' : '' %>>
              <%= c.name %>
            </option>
          <% }) %>
        </select>
      </form>
    <% } else { %>
      <a href="/channels" class="hz-badge warn" style="text-decoration:none">+ ADD CHANNEL</a>
    <% } %>

    <div class="hz-clock" id="hzClock">--:--:--</div>

    <% if (user) { %>
      <span class="hz-badge" style="margin-left:8px">👤 <%= user.username %></span>
      <form method="POST" action="/logout" style="margin:0">
        <button type="submit" class="hz-btn ghost" style="padding:4px 10px;font-size:11px">⏻ LOGOUT</button>
      </form>
    <% } %>
  </header>

  <div class="hz-body">
    <%- include('sidebar', { active: active }) %>
    <main class="hz-main">
